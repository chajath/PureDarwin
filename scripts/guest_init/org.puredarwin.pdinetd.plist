<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.puredarwin.pdinetd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/sbin/pd_inetd</string>
    <string>2323</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/pd_inetd.stdout</string>
  <key>StandardErrorPath</key><string>/var/log/pd_inetd.stderr</string>
</dict>
</plist>
